# ============================================================
# ITOps Platform - 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# 数据库配置
ITOPS_DB_HOST=localhost
ITOPS_DB_PORT=3306
ITOPS_DB_NAME=itops_platform
ITOPS_DB_USER=root
ITOPS_DB_PASSWORD=YourSecurePassword123

# JWT 密钥（建议使用随机字符串，至少32字符）
JWT_SECRET=change_this_to_a_random_string_at_least_32_chars

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# 前端配置
VITE_API_BASE_URL=http://localhost:8000

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=/var/log/itops_platform
